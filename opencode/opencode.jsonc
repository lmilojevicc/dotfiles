{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "omni",
  // Compact at 80% of the model's window (background summarizing is on by default).
  "compaction": { "buffer": "20%" },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    // --- deny: secret material on disk (read + edit) -------------------------
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/Library/Keychains/*", "effect": "deny" },
    { "action": "edit", "resource": "~/Library/Keychains/*", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/keyrings/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/keyrings/*", "effect": "deny" },

    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "read", "resource": "~/.azure/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.azure/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.kube/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/gcloud/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/doctl/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/doctl/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/hub/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/hub/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/glab-cli/*", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/glab-cli/*", "effect": "deny" },

    { "action": "read", "resource": "~/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/gh/hosts.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.docker/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/containers/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/containers/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.terraform.d/credentials.tfrc.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.terraform.d/credentials.tfrc.json", "effect": "deny" },
    { "action": "read", "resource": "~/.vault-token", "effect": "deny" },
    { "action": "edit", "resource": "~/.vault-token", "effect": "deny" },
    { "action": "read", "resource": "~/.config/rclone/rclone.conf", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/rclone/rclone.conf", "effect": "deny" },
    { "action": "read", "resource": "~/.config/sops/age/keys.txt", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/sops/age/keys.txt", "effect": "deny" },

    { "action": "read", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.config/git/credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/git/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.npmrc", "effect": "deny" },
    { "action": "read", "resource": "~/.yarnrc", "effect": "deny" },
    { "action": "edit", "resource": "~/.yarnrc", "effect": "deny" },
    { "action": "read", "resource": "~/.yarnrc.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.yarnrc.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "edit", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "~/.config/pypoetry/auth.toml", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/pypoetry/auth.toml", "effect": "deny" },
    { "action": "read", "resource": "~/.cargo/credentials.toml", "effect": "deny" },
    { "action": "edit", "resource": "~/.cargo/credentials.toml", "effect": "deny" },
    { "action": "read", "resource": "~/.cargo/credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.cargo/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.gem/credentials", "effect": "deny" },
    { "action": "edit", "resource": "~/.gem/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.composer/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.composer/auth.json", "effect": "deny" },

    // other AI tools' credential stores
    { "action": "read", "resource": "~/.claude/.credentials.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.claude/.credentials.json", "effect": "deny" },
    { "action": "read", "resource": "~/.codex/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.codex/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.gemini/oauth_creds.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.gemini/oauth_creds.json", "effect": "deny" },
    { "action": "read", "resource": "~/.qwen/oauth_creds.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.qwen/oauth_creds.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/opencode/opencode.db*", "effect": "deny" },
    { "action": "read", "resource": "~/.copilot/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.copilot/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.continue/config.yaml", "effect": "deny" },
    { "action": "edit", "resource": "~/.continue/config.yaml", "effect": "deny" },
    { "action": "read", "resource": "~/.continue/config.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.continue/config.json", "effect": "deny" },
    { "action": "read", "resource": "~/.aider.conf.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.aider.conf.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.config/crush/crush.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/crush/crush.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/crush/providers.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/crush/providers.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/goose/config.yaml", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/goose/config.yaml", "effect": "deny" },
    { "action": "read", "resource": "~/.config/goose/secrets.yaml", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/goose/secrets.yaml", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/amp/secrets.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/amp/secrets.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/amp/settings.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/amp/settings.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/github-copilot/hosts.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/github-copilot/hosts.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/github-copilot/apps.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/github-copilot/apps.json", "effect": "deny" },

    // pi / bb / omp credential stores (incl. opencode-secrets state)
    { "action": "read", "resource": "~/.bb/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.bb/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.bb/auth-secret", "effect": "deny" },
    { "action": "edit", "resource": "~/.bb/auth-secret", "effect": "deny" },
    { "action": "read", "resource": "~/.bb/bb.db", "effect": "deny" },
    { "action": "edit", "resource": "~/.bb/bb.db", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/agent/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/agent/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/agent-bb/auth.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/agent-bb/auth.json", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/agent/antigravity-accounts.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/agent/antigravity-accounts.json", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/agent-bb/antigravity-accounts.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/agent-bb/antigravity-accounts.json", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/secrets.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/secrets.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/agent/secrets.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/agent/secrets.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.pi/agent-bb/secrets.yml", "effect": "deny" },
    { "action": "edit", "resource": "~/.pi/agent-bb/secrets.yml", "effect": "deny" },
    { "action": "read", "resource": "~/.omp/agent/agent.db*", "effect": "deny" },
    { "action": "edit", "resource": "~/.omp/agent/agent.db*", "effect": "deny" },
    { "action": "read", "resource": "~/.omp/agent/history.db*", "effect": "deny" },
    { "action": "edit", "resource": "~/.omp/agent/history.db*", "effect": "deny" },
    { "action": "read", "resource": "~/.omp/auth-broker.token", "effect": "deny" },
    { "action": "edit", "resource": "~/.omp/auth-broker.token", "effect": "deny" },
    { "action": "read", "resource": "~/.omp/agent/auth-broker.token", "effect": "deny" },
    { "action": "edit", "resource": "~/.omp/agent/auth-broker.token", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/omp/agent.db*", "effect": "deny" },
    { "action": "edit", "resource": "~/.local/share/omp/agent.db*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/omp/auth-broker.token", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/omp/auth-broker.token", "effect": "deny" },
    { "action": "read", "resource": "*@gmail.com.json", "effect": "deny" },
    { "action": "edit", "resource": "*@gmail.com.json", "effect": "deny" },

    // this machine's OpenCode state
    { "action": "read", "resource": "~/.config/opencode/service.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/service.json", "effect": "deny" },
    { "action": "read", "resource": "~/.config/opencode/opencode-secrets.json", "effect": "deny" },
    { "action": "edit", "resource": "~/.config/opencode/opencode-secrets.json", "effect": "deny" },
    {
      "action": "read",
      "resource": "~/.local/share/opencode/opencode-secrets.key",
      "effect": "deny",
    },
    {
      "action": "edit",
      "resource": "~/.local/share/opencode/opencode-secrets.key",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/.local/share/opencode/opencode-secrets-learned.json",
      "effect": "deny",
    },
    {
      "action": "edit",
      "resource": "~/.local/share/opencode/opencode-secrets-learned.json",
      "effect": "deny",
    },

    // system
    { "action": "read", "resource": "/etc/shadow", "effect": "deny" },
    { "action": "edit", "resource": "/etc/shadow", "effect": "deny" },
    { "action": "read", "resource": "/etc/sudoers", "effect": "deny" },
    { "action": "edit", "resource": "/etc/sudoers", "effect": "deny" },
    { "action": "read", "resource": "/etc/sudoers.d/*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/sudoers.d/*", "effect": "deny" },
    { "action": "read", "resource": "/etc/ssh/ssh_host_*_key", "effect": "deny" },
    { "action": "edit", "resource": "/etc/ssh/ssh_host_*_key", "effect": "deny" },
    { "action": "read", "resource": "/etc/ssl/private/*", "effect": "deny" },
    { "action": "edit", "resource": "/etc/ssl/private/*", "effect": "deny" },
    { "action": "read", "resource": "/proc/*/environ", "effect": "deny" },
    { "action": "read", "resource": "~/.bash_history", "effect": "deny" },
    { "action": "read", "resource": "~/.zsh_history", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/fish/fish_history", "effect": "deny" },
    { "action": "read", "resource": "~/.config/google-chrome/*/Cookies", "effect": "deny" },
    { "action": "read", "resource": "~/.config/chromium/*/Cookies", "effect": "deny" },
    { "action": "read", "resource": "~/.mozilla/firefox/*/cookies.sqlite", "effect": "deny" },
    {
      "action": "read",
      "resource": "~/Library/Application Support/Google/Chrome/*/Cookies",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/Library/Application Support/Firefox/Profiles/*/cookies.sqlite",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/Library/Safari/Cookies/Cookies.binarycookies",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/.config/Code/User/globalStorage/state.vscdb",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/.config/Cursor/User/globalStorage/state.vscdb",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/Library/Application Support/Code/User/globalStorage/state.vscdb",
      "effect": "deny",
    },
    {
      "action": "read",
      "resource": "~/Library/Application Support/Cursor/User/globalStorage/state.vscdb",
      "effect": "deny",
    },

    // generic secret-shaped files
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.dev.vars", "effect": "deny" },
    { "action": "edit", "resource": "*.dev.vars", "effect": "deny" },
    { "action": "read", "resource": "*service-account.json*", "effect": "deny" },
    { "action": "edit", "resource": "*service-account.json*", "effect": "deny" },
    { "action": "read", "resource": "*credentials.json*", "effect": "deny" },
    { "action": "edit", "resource": "*credentials.json*", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_dsa*", "effect": "deny" },
    { "action": "edit", "resource": "*id_dsa*", "effect": "deny" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "edit", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "read", "resource": "*id_ecdsa*", "effect": "deny" },
    { "action": "edit", "resource": "*id_ecdsa*", "effect": "deny" },
    { "action": "read", "resource": "*priv*.pem*", "effect": "deny" },
    { "action": "edit", "resource": "*priv*.pem*", "effect": "deny" },
    { "action": "read", "resource": "*private*.pem*", "effect": "deny" },
    { "action": "edit", "resource": "*private*.pem*", "effect": "deny" },
    { "action": "read", "resource": "*-key.pem*", "effect": "deny" },
    { "action": "edit", "resource": "*-key.pem*", "effect": "deny" },
    { "action": "read", "resource": "*_key.pem*", "effect": "deny" },
    { "action": "edit", "resource": "*_key.pem*", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.key.*", "effect": "deny" },
    { "action": "edit", "resource": "*.key.*", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "edit", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "edit", "resource": "*.pfx", "effect": "deny" },

    // --- deny: shell access to credential material ---------------------------
    // Shell resources are raw command text (not home-expanded), so patterns
    // anchor on "/.ssh/"-style substrings that match both ~ and absolute forms.
    { "action": "shell", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.gnupg/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.kube/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.config/gcloud/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.local/share/keyrings/*", "effect": "deny" },
    { "action": "shell", "resource": "*/Library/Keychains/*", "effect": "deny" },
    { "action": "shell", "resource": "*id_rsa*", "effect": "deny" },
    { "action": "shell", "resource": "*id_dsa*", "effect": "deny" },
    { "action": "shell", "resource": "*id_ed25519*", "effect": "deny" },
    { "action": "shell", "resource": "*id_ecdsa*", "effect": "deny" },
    { "action": "shell", "resource": "*secrets.yml*", "effect": "deny" },
    { "action": "shell", "resource": "*service-account.json*", "effect": "deny" },
    { "action": "shell", "resource": "*credentials.json*", "effect": "deny" },
    { "action": "shell", "resource": "*auth.json*", "effect": "deny" },
    { "action": "shell", "resource": "*.env", "effect": "deny" },
    { "action": "shell", "resource": "*zsh_history*", "effect": "deny" },
    { "action": "shell", "resource": "*bash_history*", "effect": "deny" },
    { "action": "shell", "resource": "*fish_history*", "effect": "deny" },
    { "action": "shell", "resource": "*/etc/shadow*", "effect": "deny" },
    { "action": "shell", "resource": "*/etc/sudoers*", "effect": "deny" },
    { "action": "shell", "resource": "*ssh_host_*_key*", "effect": "deny" },
    { "action": "shell", "resource": "*/etc/ssl/private/*", "effect": "deny" },
    { "action": "shell", "resource": "*/proc/*/environ*", "effect": "deny" },
    { "action": "shell", "resource": "*cookies.sqlite*", "effect": "deny" },
    { "action": "shell", "resource": "*/Cookies*", "effect": "deny" },
    { "action": "shell", "resource": "*opencode-secrets*", "effect": "deny" },
    { "action": "shell", "resource": "*/opencode/service.json*", "effect": "deny" },

    // --- carve-out allows (must come after the denies they override) ---------
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*service-account.json.example*", "effect": "allow" },
    { "action": "read", "resource": "*service-account.json.template*", "effect": "allow" },
    { "action": "read", "resource": "*service-account.json.sample*", "effect": "allow" },
    { "action": "read", "resource": "*/testdata/service-account.json", "effect": "allow" },
    { "action": "read", "resource": "*/fixtures/service-account.json", "effect": "allow" },
    { "action": "read", "resource": "*credentials.json.example*", "effect": "allow" },
    { "action": "read", "resource": "*credentials.json.template*", "effect": "allow" },
    { "action": "read", "resource": "*credentials.json.sample*", "effect": "allow" },
    { "action": "read", "resource": "*/testdata/credentials.json", "effect": "allow" },
    { "action": "read", "resource": "*/fixtures/credentials.json", "effect": "allow" },
    { "action": "read", "resource": "*id_*.pub", "effect": "allow" },
    { "action": "shell", "resource": "*.env.example*", "effect": "allow" },
    { "action": "shell", "resource": "*id_*.pub", "effect": "allow" },
  ],
  "mcp": {
    "servers": {
      "pi-web-access": {
        "type": "local",
        "command": ["npx", "-y", "pi-web-access"],
        "timeout": {
          "startup": 60000,
        },
      },
    },
  },
  "plugins": [
    { "package": "./plugins/opencode-secrets", "options": { "enabled": true } },
    // FFF file/content search as native tools (ffgrep, fffind); run `bun install` in the plugin dir first.
    { "package": "./plugins/opencode-fff" },
  ],
}
