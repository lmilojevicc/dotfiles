        "400": "#81b37d",
        "500": "#729b6f",
        "600": "#648461",
        "700": "#587056",
        "800": "#4c5d4a",
        "900": "#424d41"
      },
      "cyan": {
        "100": "#acedf9",
        "200": "#89dceb",
        "300": "#77c5d2",
        "400": "#69adb9",
        "500": "#5e959f",
        "600": "#547f86",
        "700": "#4c6b71",
        "800": "#43595d",
        "900": "#3c4a4c"
      },
      "blue": {
        "100": "#a5c8ff",
        "200": "#89b4fa",
        "300": "#769edf",
        "400": "#6689c1",
        "500": "#5774a3",
        "600": "#4a6084",
        "700": "#3f4f6b",
        "800": "#333f52",
        "900": "#2b323f"
      },
      "purple": {
