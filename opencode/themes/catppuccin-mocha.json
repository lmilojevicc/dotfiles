{
  "base": {
    "categorical": ["blue", "purple", "green", "orange", "red"],
    "text": {
      "base": "#cdd6f4",
      "muted": "#a6adc8",
      "faint": "#7f849c",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.faint",
          "$focused": "$text.base",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.interactive.200"
        },
        "destructive": {
          "base": "$hue.neutral.900",
          "$disabled": "$text.faint",
          "$focused": "$hue.neutral.900"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$focused": "$hue.interactive.200",
        "$selected": "$hue.interactive.200",
        "$disabled": "$text.faint"
      },
      "feedback": {
        "error": {
          "base": "#f38ba8",
          "muted": "#d87893"
        },
        "warning": {
          "base": "#f9e2af",
          "muted": "#e1cb9c"
        },
        "success": {
          "base": "#a6e3a1",
          "muted": "#92cb8e"
        },
        "info": {
          "base": "#89dceb",
          "muted": "#77c5d2"
        }
      }
    },
    "background": {
      "base": "#11111b",
      "raised": {
        "base": "#1e1e2e",
        "high": "#1e1e2e",
        "max": "#313244"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.max",
          "$focused": "$hue.interactive.800",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200",
          "$focused": "$hue.red.100"
        }
      },
      "formfield": {
        "base": "$background.raised.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#313244"
    },
    "scrollbar": {
      "base": "#45475a"
    },
    "diff": {
      "text": {
        "added": "#a6e3a1",
        "removed": "#f38ba8",
        "context": "#a6adc8",
        "hunkHeader": "#fab387"
      },
      "background": {
        "added": "#24312b",
        "removed": "#3c2a32",
        "context": "#1e1e2e"
      },
      "highlight": {
        "added": "#c2f3be",
        "removed": "#fca6bc"
      },
      "lineNumber": {
        "text": "#6c7086",
        "background": {
          "added": "#1e2a25",
          "removed": "#32232a"
        }
      }
    },
    "syntax": {
      "comment": "#9399b2",
      "keyword": "#cba6f7",
      "function": "#89b4fa",
      "variable": "#cdd6f4",
      "string": "#a6e3a1",
      "number": "#fab387",
      "type": "#f9e2af",
      "operator": "#89dceb",
      "punctuation": "#a6adc8"
    },
    "markdown": {
      "text": "#cdd6f4",
      "heading": "#cba6f7",
      "link": "#89b4fa",
      "linkText": "#74c7ec",
      "code": "#fab387",
      "blockQuote": "#a6adc8",
      "emphasis": "#f5c2e7",
      "strong": "#f9e2af",
      "horizontalRule": "#45475a",
      "listItem": "#89b4fa",
      "listEnumeration": "#89dceb",
      "image": "#89b4fa",
      "imageText": "#74c7ec",
      "codeBlock": "#cdd6f4"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "base": "transparent",
            "$hovered": "$background.raised.max"
          },
          "secondary": {
            "base": "transparent",
            "$hovered": "$background.raised.max"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#cdd6f4",
        "200": "#a6adc8",
        "300": "#7f849c",
        "400": "#6c7086",
        "500": "#45475a",
        "600": "#313244",
        "700": "#1e1e2e",
        "800": "#181825",
