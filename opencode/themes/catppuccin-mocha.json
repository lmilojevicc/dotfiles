        "900": "#3a3442"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "syntax": {
      "comment": "#9399b2",
      "keyword": "#cba6f7",
      "function": "#89b4fa",
      "variable": "#cdd6f4",
      "string": "#a6e3a1",
      "number": "#fab387",
      "type": "#f9e2af",
      "operator": "#89dceb",
      "punctuation": "#a6adc8"
    },
    "markdown": {
      "text": "#cdd6f4",
      "heading": "#cba6f7",
      "link": "#89b4fa",
      "linkText": "#74c7ec",
      "code": "#fab387",
      "blockQuote": "#a6adc8",
      "emphasis": "#f5c2e7",
      "strong": "#f9e2af",
      "horizontalRule": "#45475a",
      "listItem": "#89b4fa",
      "listEnumeration": "#89dceb",
      "image": "#89b4fa",
      "imageText": "#74c7ec",
      "codeBlock": "#cdd6f4"
    }
  }
}
