{
  "lastChangelogVersion": "1.4.0",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "xhigh",
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-mcp-adapter",
    "npm:pi-antigravity",
    "npm:pi-lens",
    "npm:@gotgenes/pi-permission-system",
    "npm:@k3_2o/pi-secrets",
    "npm:pi-freeflow"
  ],
  "skills": [".claude/skills", ".codex/skills", ".opencode/skills"],
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "secrets": {
    "enabled": true
  },
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "showHardwareCursor": false,
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "treeFilterMode": "no-tools",
  "extensions": [
    "~/.pi/agent/extensions/agent-policy",
    "~/.pi/agent/extensions/auto-compact",
    "~/.pi/agent/extensions/bash-improved",
    "~/.pi/agent/extensions/model-blacklist",
    "~/.pi/agent/extensions/model-instructions",
    "-builtin:mcp"
  ],
  "defaultTools": ["+codemode", "+find", "+grep", "+tool_search"]
}
