  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-zentui",
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/MasuRii/pi-tool-display",
    "npm:@ff-labs/pi-fff",
    "npm:pi-btw",
    "npm:pi-mcp-adapter",
    "npm:pi-antigravity",
    "npm:pi-interactive-shell",
    "npm:pi-commandcode-provider",
    "npm:pi-claude-bridge"
