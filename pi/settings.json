{
  "lastChangelogVersion": "1.3.0",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "xhigh",
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-intercom",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "npm:pi-mcp-adapter",
    "npm:pi-antigravity",
    "npm:pi-commandcode-provider",
    "npm:pi-claude-bridge"
  ],
  "skills": [
    ".claude/skills",
    ".codex/skills",
    ".opencode/skills"
  ],
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "showHardwareCursor": false,
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "treeFilterMode": "no-tools",
  "extensions": [
    "extensions/extension-manager/loader.ts",
    "-builtin:mcp",
    "-extensions/broadcast-reload/index.ts",
    "-extensions/codex-enhanced/index.ts",
    "-extensions/context/index.ts",
    "-extensions/herdr-agent-state.ts",
    "-extensions/herdr-pane-namesmith/index.ts",
    "-extensions/message-jump/index.ts",
    "-extensions/prefix-keybinds/index.ts",
    "-extensions/seshagy-agent-state.ts",
    "-extensions/session-auto-rename/index.ts",
    "-extensions/session-to-pane/index.ts",
    "-extensions/startup-header.ts",
    "-extensions/tasks/index.ts",
    "-extensions/terminal-focus-cursor/index.ts",
    "-extensions/usage/index.ts"
  ]
}