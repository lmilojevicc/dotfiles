{
  "lastChangelogVersion": "1.1.0",
  "defaultProvider": "opencode-go",
  "defaultModel": "deepseek-v4.1-flash",
  "defaultThinkingLevel": "xhigh",
  "theme": "catppuccin-mocha",
  "packages": [
    "npm:pi-zentui",
    "npm:pi-intercom",
    "npm:pi-web-access",
    {
      "source": "npm:pi-subagents",
      "extensions": []
    },
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:@narumitw/pi-goal",
      "extensions": [
        "-dist/index.ts"
      ]
    },
    "git:github.com/MasuRii/pi-tool-display",
    "npm:@ff-labs/pi-fff",
    "npm:pi-btw",
    "npm:pi-mcp-adapter",
    "npm:pi-antigravity",
    {
      "source": "npm:pi-commandcode-provider",
      "extensions": [
        "-index.ts"
      ]
    }
  ],
  "skills": [
    ".claude/skills",
    ".codex/skills",
    ".opencode/skills"
  ],
  "doubleEscapeAction": "tree",
  "quietStartup": true,
  "enableInstallTelemetry": false,
  "collapseChangelog": true,
  "showHardwareCursor": false,
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "defaultProjectTrust": "ask",
  "tuiMode": "fullscreen",
  "treeFilterMode": "no-tools",
  "extensions": [
    "extensions/pi-subagents-host-gate/loader.ts",
    "-extensions/command-code/index.ts",
    "-extensions/chadineer/index.ts",
    "-extensions/redaction/index.ts",
    "-builtin:mcp"
  ]
}