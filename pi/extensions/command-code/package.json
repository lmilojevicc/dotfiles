{
  "name": "pi-extension-command-code",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import ./tests/register-loader.mjs --test tests/*.test.ts",
    "test:sdk": "node --import ./tests/register-sdk-loader.mjs --test tests/*.sdk.ts && npm run test:production-loader",
    "test:production-loader": "JITI_FS_CACHE=false NODE_DISABLE_COMPILE_CACHE=1 node --test tests/production-loader.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*"
  }
}
