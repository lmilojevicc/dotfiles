{
  "name": "pi-local-redaction",
  "version": "0.1.0",
  "description": "Opt-in local Rust-backed text redaction for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./index.ts"] },
  "files": ["index.ts", "tsconfig.json", "src", "native/Cargo.toml", "native/Cargo.lock", "native/build.rs", "native/LICENSE", "native/README.md", "native/src", "native/tests", "tests", "scripts", "config.example.json", "README.md", "LICENSE", "docs", "fixtures", "benchmarks/run.sh", "benchmarks/run.mjs", "benchmarks/workloads.mjs", "benchmarks/core/Cargo.toml", "benchmarks/core/Cargo.lock", "benchmarks/core/src/main.rs", "benchmarks/results/latest.json", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:settings": "node --experimental-strip-types --test tests/settings-*.test.ts",
    "test:native": "node --test native/tests/native.test.cjs",
    "test:rust": "cargo test --locked --manifest-path native/Cargo.toml",
    "test:integration": "node --experimental-strip-types --test tests/integration*.test.ts",
    "check": "tsc --noEmit",
    "build:native": "node scripts/build-native.mjs",
    "benchmark": "bash benchmarks/run.sh",
    "test:corpus": "node --experimental-strip-types --test tests/corpus*.test.ts",
    "test:packaging": "node --experimental-strip-types --test tests/corpus-packaging.test.ts"
  },
  "engines": { "node": ">=22.18.0" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": { "@types/node": "^22.0.0", "typescript": "^5.8.0" }
}
