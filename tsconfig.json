{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "target": "es2023",
    "lib": ["es2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["pi/extensions/**/*.ts", "pi/*.ts"],
  "exclude": ["**/tests/**", "**/node_modules/**"]
}
