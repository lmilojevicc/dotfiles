#!/usr/bin/env bash
# Verify the repo matches what the pre-commit hook would produce: no writes, exit
# non-zero on any drift, plus the two gates the hook skips for speed (type check).
# Used by `mise run check`.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"
# shellcheck source=.githooks/_format.sh
source .githooks/_format.sh

rc=0

oxfmt --check || rc=1
stylua --check . || rc=1

shell=()
while IFS= read -r -d '' f; do
  case "$f" in
  *.sh) shell+=("$f") ;;
  *.lua) ;;
  *) dotfiles_is_shell "$f" && shell+=("$f") ;;
  esac
done < <(git ls-files -z)
shfmt --diff --indent 2 -- "${shell[@]}" || rc=1

# Type-aware lint and a real type check need Pi's installed .d.ts, linked into a
# gitignored node_modules/ (no downloads: the links point at Pi's managed install).
bash mise-tasks/pi-types --quiet
oxlint --type-aware --deny-warnings . || rc=1
tsc -p tsconfig.json || rc=1

exit $rc
